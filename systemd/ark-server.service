# Benjamin Michael Taylor (bentaylorhk)
# 2026

[Unit]
Description=ARK: Survival Evolved dedicated server
ConditionHost=polyphonic-1
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=ark
Group=ark
WorkingDirectory=/srv/ark-se/ShooterGame/Binaries/Linux
ExecStartPre=/usr/bin/steamcmd +force_install_dir /srv/ark-se +login anonymous +app_update 376030 +quit
ExecStart=/srv/ark-se/ShooterGame/Binaries/Linux/ShooterGameServer TheIsland?listen?MaxPlayers=15 -server -log
Restart=on-failure
RestartSec=10
KillSignal=SIGINT
TimeoutStopSec=120
LimitNOFILE=100000

[Install]
WantedBy=multi-user.target
